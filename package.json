{
  "name": "tommybrown",
  "version": "0.1.0",
  "private": true,
  "description": "A desktop home for coding agents and connected work",
  "type": "module",
  "main": "dist/main/index.cjs",
  "scripts": {
    "check": "tsc --noEmit",
    "lint": "biome check .",
    "test": "vitest run",
    "test:proxy": "vitest run tests/proxy",
    "smoke:proxy": "bun run scripts/proxy-smoke.ts",
    "build": "bun run scripts/build.ts",
    "start": "electron .",
    "test:desktop": "playwright test",
    "doctor:react": "react-doctor . --verbose"
  },
  "trustedDependencies": [
    "electron",
    "esbuild"
  ],
  "dependencies": {
    "@radix-ui/react-icons": "^1.3.2",
    "fflate": "0.8.2",
    "ky": "2.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "electron": "44.5.1",
    "esbuild": "^0.28.2",
    "react-doctor": "^0.9.14",
    "react-grab": "^0.2.0",
    "react-scan": "^0.5.7",
    "typescript": "7.0.2",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
